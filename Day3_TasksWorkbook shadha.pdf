{
  "nodes": [
    {
      "name": "Weekly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "rule": "Mon 08:00 Asia/Muscat"
    },
    {
      "name": "Read CSV",
      "type": "n8n-nodes-base.httpRequest",
      "credentials": "source credential"
    },
    {
      "name": "Validate/redact",
      "type": "n8n-nodes-base.code"
    },
    {
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "condition": "valid && count > 0"
    },
    {
      "name": "Classify",
      "type": "n8n-nodes-base.httpRequest",
      "method": "POST",
      "url": "https://api.openai.com/v1/chat/completions",
      "credential": "OpenAI",
      "body": {
        "model": "gpt-4o-mini",
        "messages": "CRTFC system + sanitized rows"
      }
    },
    {
      "name": "Check response",
      "type": "n8n-nodes-base.code"
    },
    {
      "name": "Draft for reviewer",
      "type": "n8n-nodes-base.httpRequest",
      "method": "POST",
      "target": "private review queue"
    },
    {
      "name": "Exceptions",
      "type": "n8n-nodes-base.noOp"
    }
  ],
  "connections": [
    [
      "Weekly",
      "Read CSV"
    ],
    [
      "Read CSV",
      "Validate/redact"
    ],
    [
      "Validate/redact",
      "Valid?"
    ],
    [
      "Valid?:true",
      "Classify"
    ],
    [
      "Valid?:false",
      "Exceptions"
    ],
    [
      "Classify",
      "Check response"
    ],
    [
      "Check response:valid",
      "Draft for reviewer"
    ],
    [
      "Check response:invalid",
      "Exceptions"
    ]
  ]
}
endstream
