import json, unittest, tempfile
from pathlib import Path
from unittest.mock import patch
import pandas as pd
import developer_extensions as d

class TestDeveloperExtensions(unittest.TestCase):
    def test_report_structure_and_week_filter(self):
        expected='\n'.join(h+'\nReviewed sample.' for h in d.HEADINGS)
        with patch.object(d, 'call_api', return_value=expected) as api:
            actual=d.generate_sales_report(d.BASE/'sales.csv','2024-03-01','All')
        self.assertEqual(actual,expected)
        metrics=json.loads(api.call_args.args[1])
        self.assertEqual(metrics['revenue'],5219.77)
        self.assertEqual(metrics['orders'],8)
        self.assertTrue(all(h in actual for h in d.HEADINGS))

    def test_classifier_batches_and_rejects_wrong_ids(self):
        def fake(system,user,json_mode):
            rows=json.loads(user)
            return json.dumps({'items':[{'ID':r['ID'],'Category':'Other',
                'Sentiment':'Negative','Key Theme':'Mock only','Priority':'Medium'} for r in rows]})
        with tempfile.TemporaryDirectory() as td:
            source=Path(td)/'input.csv';out=Path(td)/'output.csv'
            pd.DataFrame([{'ID':f'F{i:03}','Feedback Text':'Example'} for i in range(1,16)]).to_csv(source,index=False)
            with patch.object(d,'call_api',side_effect=fake) as api:
                result=d.classify_feedback(source,out)
            self.assertEqual([len(json.loads(c.args[1])) for c in api.call_args_list],[10,5])
            self.assertEqual(len(result),15)
            with patch.object(d,'call_api',return_value='{"items":[]}'):
                invalid=d.classify_feedback(source,out)
            self.assertTrue(invalid.empty)

if __name__=='__main__': unittest.main()

endstream
endobj
